{
  "compilerOptions": {
    // Not ours: tsup's d.ts step sets `baseUrl: compilerOptions.baseUrl || "."`
    // unconditionally (tsup/dist/rollup.js), and TypeScript 6 errors on that
    // deprecated option — the DTS build dies while `tsc --noEmit` passes. Drop
    // this the day tsup stops injecting baseUrl; the same code path is what
    // blocks TypeScript 7, where it throws outright.
    "ignoreDeprecations": "6.0",
    // Name the global type packages explicitly. TypeScript's automatic "load
    // every @types/* in node_modules" is sensitive to the shape of the
    // installed tree: under TypeScript 6 a FRESH install stops resolving
    // node:fs / node:url (TS2591) while an incrementally-grown local tree keeps
    // working — green locally, red in CI, on the same commit.
    "types": ["node"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedModules": true,

    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
